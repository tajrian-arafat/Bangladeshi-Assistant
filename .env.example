# Bangladesh Digital Assistant — Environment Configuration
# Copy to .env and fill in values for local development.

# Application
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
APP_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database — SQLite for local dev, PostgreSQL for staging/production
DATABASE_URL=sqlite+aiosqlite:///./backend/data/bda.db
# DATABASE_URL=postgresql+asyncpg://bda:bda@localhost:5432/bda
DATABASE_POOL_SIZE=20
DATABASE_ECHO=false

# Redis (cache, Celery broker, rate limiting)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=change-me-jwt-secret-key-use-openssl-rand-hex-32
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Local LLM (llama.cpp server)
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL_PRIMARY=qwen2.5-7b-instruct
LLM_MODEL_FALLBACK=qwen2.5-3b-instruct
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# Feature flags (defaults; DB flags override in admin)
FEATURE_DOCUMENT_UPLOAD=false
FEATURE_PLAYWRIGHT_CRAWL=false
FEATURE_LLM_ENABLED=true

# Logging and observability
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=false

# Rate limiting
RATE_LIMIT_ANONYMOUS_PER_MIN=20
RATE_LIMIT_AUTH_PER_MIN=60

# Crawler
CRAWLER_USER_AGENT=BDABot/1.0 (+https://example.org/bot; contact=admin@example.org)

# MinIO (optional — for artifacts and temp document storage)
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET_ARTIFACTS=bda-artifacts
# MINIO_BUCKET_TEMP=bda-temp

# Convex agent mode (cloud coding agents only — not needed for local dev)
# CONVEX_AGENT_MODE=anonymous
